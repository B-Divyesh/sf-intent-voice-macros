{
  "name": "intent-voice-macros",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "clean": "node scripts/clean.mjs",
    "prepare:wxt": "wxt prepare",
    "pretest": "npm run prepare:wxt",
    "typecheck": "npm run prepare:wxt && tsc --noEmit",
    "build:extension": "wxt build && wxt zip",
    "build:site": "npm run build:extension && vite build --config vite.site.config.ts && node scripts/copy-extension.mjs && node scripts/verify-package.mjs",
    "build": "npm run clean && npm run build:site",
    "test": "vitest run && playwright test",
    "test:e2e": "playwright test",
    "test:package": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  }
}
